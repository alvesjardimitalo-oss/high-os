rules_version = '2';

/* =============================================================
   REGRAS DO FIRESTORE · projeto high-os
   Este projeto é COMPARTILHADO: High OS (painel do Ilegal) e Ítalo InfoTec
   (bloco /ti, copiado de italo-alves-ti/firebase/regras-ti.rules).
   Antes de publicar, confira no Console se existe alguma regra de OUTRO
   app que não esteja aqui — publicar substitui o arquivo inteiro.

   PUBLICAR: Firebase Console > Firestore Database > Regras > colar > Publicar.

   Staff do High OS em users/{email}: { role: 'ADMIN' | 'STAFF' | 'CONSULTA' | 'RH_*', active: true }
   ============================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identidade ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function perfilPath() {
      return /databases/$(database)/documents/users/$(myEmail());
    }
    function activeUser() {
      return signedIn() && exists(perfilPath()) && get(perfilPath()).data.get('active', true) != false;
    }
    function role() {
      return activeUser() ? get(perfilPath()).data.get('role', 'CONSULTA').upper() : 'NONE';
    }
    function isAdmin() {
      return role() == 'ADMIN';
    }
    // staff: tudo que não é ADMIN, CONSULTA ou RH_* (perfis só de leitura)
    function isStaff() {
      return activeUser() && (isAdmin() || !(role() == 'CONSULTA' || role().matches('RH_.*')));
    }

    // ---------- HIGH OS · usuários ----------
    match /users/{email} {
      allow get: if signedIn() && (email.lower() == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------- HIGH OS · webhooks dos avisos (endereços ficam fora do código público) ----------
    match /hos/config/privado/webhooks {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------- HIGH OS · registro dos avisos publicados ----------
    match /hos/dados/avisos/{avisoId} {
      allow read: if activeUser();
      allow create: if isStaff()
                    && request.resource.data.por == myEmail()
                    && request.resource.data.tipo in ['entrega', 'recolhimento']
                    && request.resource.data.group is string
                    && request.resource.data.group.size() <= 40
                    && request.resource.data.em == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- HIGH OS · planejador de missões (uma zona por documento) ----------
    // "rev" só avança de 1 em 1: quem está com versão antiga não sobrescreve o trabalho de outro.
    match /highos/data/missoes_zonas/{zonaId} {
      allow read: if activeUser();
      allow create: if isStaff()
                    && request.resource.data.rev == 1
                    && request.resource.data.updatedBy == myEmail()
                    && request.resource.data.json is string
                    && request.resource.data.json.size() <= 900000;
      allow update: if isStaff()
                    && request.resource.data.rev == resource.data.rev + 1
                    && request.resource.data.updatedBy == myEmail()
                    && request.resource.data.json is string
                    && request.resource.data.json.size() <= 900000;
      allow delete: if isAdmin();
    }

    // ---------- Ítalo Alves TI (assistência técnica · repo italo-alves-ti) ----------
    // Só o dono acessa. Dados em ti/base/{colecao}/{doc} e ti/base/meta/{config|contadores}.
    function tiDono() {
      return signedIn()
        && myEmail() in ['alvesjardim.italo@gmail.com']
        && request.auth.token.email_verified == true;
    }
    match /ti/{document=**} {
      allow read, write: if tiDono();
    }
    // Site público: qualquer visitante pode CRIAR um pedido ("Fale comigo"),
    // mas não pode ler, alterar nem apagar. Campos e tamanhos travados.
    function tiTexto(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    match /ti/base/leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'whatsapp', 'cidade', 'equipamento', 'problema',
                         'detalhe', 'atendimento', 'servico', 'origem', 'utm', 'indicacao', 'status', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.matches('^[0-9]{10,13}$')
        && tiTexto(request.resource.data, 'cidade', 80)
        && tiTexto(request.resource.data, 'equipamento', 40)
        && tiTexto(request.resource.data, 'problema', 60)
        && tiTexto(request.resource.data, 'detalhe', 1500)
        && tiTexto(request.resource.data, 'atendimento', 40)
        && tiTexto(request.resource.data, 'servico', 40)
        && tiTexto(request.resource.data, 'origem', 120)
        && tiTexto(request.resource.data, 'utm', 120)
        && tiTexto(request.resource.data, 'indicacao', 60)
        && request.resource.data.status == 'Novo'
        && request.resource.data.criadoEm == request.time;
    }
    // Métricas sem dados pessoais: só CRIAÇÃO de eventos com campos fixos.
    // A leitura permanece restrita ao dono pela regra match /ti/{document=**}.
    // IMPORTANTE: regras não fazem rate limit; acompanhar cotas/abuso do Firestore.
    // Não ativar enforcement geral do App Check do projeto high-os sem adaptar os outros apps.
    match /ti/base/metricasSite/{eventoId} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'categoria', 'pagina', 'canal', 'criadoEm'])
        && request.resource.data.keys().hasAll(['tipo', 'categoria', 'pagina', 'canal', 'criadoEm'])
        && request.resource.data.tipo in ['visita', 'chat_aberto', 'sintoma_selecionado',
                      'ferramenta_iniciada', 'ferramenta_concluida', 'whatsapp_aberto']
        && request.resource.data.categoria is string
        && request.resource.data.categoria.matches('^[a-z0-9-]{0,36}$')
        && request.resource.data.pagina in ['inicio', 'ferramentas', 'dicas', 'atendimento', 'acompanhar', 'institucional']
        && request.resource.data.canal in ['social', 'whatsapp', 'busca', 'email', 'referencia', 'direto']
        && request.resource.data.criadoEm == request.time;
    }
    // Black Friday da Karen: cada frasco é uma VAGA numerada (ex.: kaiak-extremo-2).
    // Reservar = gravar a vaga com uma "trava" (SHA-256 de um segredo que só o
    // celular da cliente conhece). O Firebase só aceita reservar vaga livre:
    // nunca usada, cancelada ou vencida (10 min sem pagamento). Duas clientes
    // não pegam a mesma vaga. Cancelar: só quem tem o segredo da trava.
    // Sem dados pessoais aqui. A Karen (tiDono) altera tudo pelo painel.
    function tiVagaLivre(r) {
      return !(('pagoEm' in r) && r.pagoEm != '')
        && ((('canceladoEm' in r) && r.canceladoEm != '') || r.criadoEm + duration.value(10, 'm') < request.time);
    }
    function tiVagaNova(id, d) {
      return id.matches('^[a-z0-9][a-z0-9-]{0,39}-[0-9]{1,3}$')
        && d.keys().hasOnly(['trava', 'criadoEm'])
        && d.trava is string && d.trava.matches('^[0-9a-f]{64}$')
        && d.criadoEm == request.time;
    }
    function tiVagaCancelada(antes, d) {
      return d.keys().hasOnly(['trava', 'criadoEm', 'canceladoEm', 'segredo'])
        && d.trava == antes.trava && d.criadoEm == antes.criadoEm
        && d.canceladoEm == request.time
        && d.segredo is string && d.segredo.size() <= 64
        && hashing.sha256(d.segredo).toHexString().lower() == antes.trava
        && !(('pagoEm' in antes) && antes.pagoEm != '');
    }
    match /ti/base/vagas-bf/{vagaId} {
      allow get: if true;
      allow list: if request.query.limit <= 500;
      allow create: if tiVagaNova(vagaId, request.resource.data);
      allow update: if (tiVagaNova(vagaId, request.resource.data) && tiVagaLivre(resource.data))
        || tiVagaCancelada(resource.data, request.resource.data);
    }
    // "Acompanhar OS": o visitante só LÊ um documento se souber o ID exato
    // (hash do código da OS + telefone). Não dá para listar nem gravar.
    match /ti/base/rastreio/{rastreioId} {
      allow get: if true;
    }

    // ---------- tudo que não foi previsto fica fechado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
