rules_version = '2';

/* =============================================================
   HIGH OS · REGRAS DE SEGURANCA DO FIRESTORE (V12.7)
   -------------------------------------------------------------
   Ate a V9.3 nao existia arquivo de regras no repositorio: toda a
   autorizacao era feita apenas no navegador (isAdmin / canEditModule),
   o que qualquer usuario logado conseguia contornar pelo console.
   Estas regras replicam o mesmo modelo de permissoes NO SERVIDOR.

   PUBLICAR:
     firebase deploy --only firestore:rules,firestore:indexes
   ou cole o conteudo em: Firebase Console > Firestore > Regras.

   Modelo de usuario esperado em users/{email}:
     { role: 'ADMIN' | 'CONSULTA' | 'RH_METRICAS' | ...,
       active: true,
       permissions: { metricas: 'EDIT', historico: 'VIEW', ... } }
   ============================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identidade ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function lowerPath() {
      return /databases/$(database)/documents/users/$(myEmail());
    }
    function rawPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email);
    }
    function registered() {
      return signedIn() && (exists(lowerPath()) || exists(rawPath()));
    }
    function profile() {
      return exists(lowerPath()) ? get(lowerPath()).data : get(rawPath()).data;
    }
    function activeUser() {
      return registered() && profile().get('active', true) != false;
    }
    function role() {
      return activeUser() ? profile().get('role', 'CONSULTA').upper() : 'NONE';
    }
    function isAdmin() {
      return role() == 'ADMIN';
    }
    function metricOnly() {
      return role() in ['RH_METRICAS', 'RH_VISUALIZADOR', 'RH_ANALISTA', 'RH_GESTOR'];
    }

    // ---------- permissoes por modulo (espelha defaultPermissionsForRole) ----------
    function defaultPerm(mod) {
      return isAdmin()
        ? 'EDIT'
        : metricOnly()
          ? ((mod == 'metricas' || mod == 'dashboard') ? 'VIEW' : 'NONE')
          : role() == 'CONSULTA'
            ? 'VIEW'
            : (mod == 'historico' ? 'VIEW' : 'EDIT');
    }
    function permFor(mod) {
      return isAdmin()
        ? 'EDIT'
        : (activeUser()
            && profile().get('permissions', {}).keys().hasAll([mod]))
          ? profile().permissions[mod].upper()
          : defaultPerm(mod);
    }
    function canView(mod) { return permFor(mod) in ['VIEW', 'EDIT']; }
    function canEdit(mod) { return permFor(mod) == 'EDIT'; }

    // ---------- usuarios ----------
    match /users/{email} {
      // cada um le o proprio cadastro; ADMIN le todos (tela de Usuarios)
      allow get: if signedIn() && (email.lower() == myEmail() || isAdmin());
      allow list: if isAdmin();
      // somente ADMIN cria, altera cargo/permissoes ou desativa
      allow create, update, delete: if isAdmin();
    }

    // ---------- dados operacionais ----------
    match /highos/data/faccoes/{docId} {
      allow read: if canView('faccoes');
      allow write: if canEdit('faccoes');
    }
    match /highos/data/organizacoes/{docId} {
      allow read: if canView('faccoes');
      allow write: if canEdit('faccoes');
    }
    match /highos/data/entregas/{docId} {
      allow read: if canView('faccoes');
      allow write: if canEdit('faccoes');
    }
    // V12.5 - o print do painel anexado ao recolhimento mora aqui. Sem esta
    // regra o catch-all no fim do arquivo recusava a gravacao e o recolhimento
    // COM print abortava inteiro (o Group nem chegava a ficar vago).
    // O registro e prova: ninguem altera; so ADMIN apaga.
    match /highos/data/evidencias_recolhimento/{docId} {
      allow read: if canView('faccoes');
      allow create: if canEdit('faccoes')
                    && request.resource.data.get('createdBy', '').lower() == myEmail()
                    && request.resource.data.get('imagemDataUrl', '') is string
                    && request.resource.data.imagemDataUrl.matches('^data:image/(jpeg|png|webp);base64,.*')
                    && request.resource.data.imagemDataUrl.size() <= 800000;
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Trilha imutável de transferências de ocupação. Sem este match, os
    // writeBatch de TRANSFER_PANEL são negados pelo bloqueio geral abaixo.
    match /highos/data/ocupacoes/{docId} {
      allow read: if canView('faccoes');
      allow create: if canEdit('faccoes')
                    && request.resource.data.get('createdBy', '').lower() == myEmail()
                    && request.resource.data.get('tipo', '') == 'TRANSFERENCIA_GROUP'
                    && request.resource.data.get('groupOrigem', '') is string
                    && request.resource.data.get('groupDestino', '') is string;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /highos/data/solicitacoes/{docId} {
      allow read: if canView('solicitacoes');
      allow write: if canEdit('solicitacoes');
    }
    // V10 - espelho mensal: um documento por mes, no lugar de 10 mil linhas
    match /highos/data/metricas_mensais/{mes} {
      allow read: if canView('metricas');
      allow write: if canEdit('metricas');
    }
    match /highos/data/metricas/{docId} {
      allow read: if canView('metricas');
      allow write: if canEdit('metricas');
    }

    // Historico e auditoria: quem enxerga o modulo le;
    // qualquer usuario ativo pode ACRESCENTAR evento (o app registra tudo),
    // mas ninguem altera ou apaga registro passado, exceto ADMIN.
    match /highos/data/historico/{docId} {
      allow read: if canView('historico') || isAdmin();
      // V12.5 - o autor do evento precisa ser quem esta logado: antes qualquer
      // usuario ativo podia gravar um log em nome de outra pessoa.
      allow create: if activeUser()
                    && request.resource.data.get('usuario', '') is string
                    && request.resource.data.usuario.lower() == myEmail();
      allow update, delete: if isAdmin();
    }
    // V12.5 - cada um cria e atualiza apenas a PROPRIA sessao, e nao pode
    // trocar o dono de uma sessao existente.
    match /highos/data/sessoes_usuario/{docId} {
      allow read: if isAdmin();
      allow create: if activeUser()
                    && request.resource.data.get('email', '') is string
                    && request.resource.data.email.lower() == myEmail();
      allow update: if activeUser()
                    && resource.data.get('email', '').lower() == myEmail()
                    && request.resource.data.get('email', '') == resource.data.get('email', '');
      allow delete: if isAdmin();
    }
    match /highos/data/alertas_dashboard/{docId} {
      allow read: if canView('dashboard');
      allow write: if canEdit('dashboard');
    }

    // ---------- chat interno: so os dois participantes ----------
    // IMPORTANTE: numa consulta de lista o Firestore avalia a regra contra os
    // FILTROS da consulta, nao documento a documento. Por isso a regra usa o
    // campo participants e o app consulta com array-contains no mesmo campo.
    match /highos/data/chat_mensagens/{docId} {
      allow read: if isAdmin()
                  || (activeUser() && canView('chat')
                      && myEmail() in resource.data.get('participants', []));
      allow create: if activeUser() && canEdit('chat')
                    && request.resource.data.email.lower() == myEmail()
                    && request.resource.data.recipientEmail is string
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && myEmail() in request.resource.data.participants
                    && request.resource.data.recipientEmail.lower() in request.resource.data.participants
                    && request.resource.data.get('texto', '').size() <= 1000;
      // update liberado apenas para ADMIN: e o que permite rodar a migracao
      // que preenche participants nas mensagens antigas (tools/migrar-chat.html)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- sinalizacao de chamadas do messenger ----------
    match /highos/data/call_signals/{docId} {
      allow read: if activeUser() && canView('chat')
                  && myEmail() in resource.data.get('participants', []);
      allow create: if activeUser() && canView('chat')
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && myEmail() in request.resource.data.participants;
      allow update: if activeUser() && canView('chat')
                    && myEmail() in resource.data.get('participants', [])
                    && request.resource.data.participants == resource.data.participants;
      allow delete: if activeUser() && canView('chat')
                    && myEmail() in resource.data.get('participants', []);
    }

    // ---------- metricas: configuracao da fonte ----------
    match /highos/metricas_config {
      allow read: if activeUser();
      allow write: if canEdit('metricas');
    }

    // ---------- fila de atualizacoes para o bot ----------
    // O bot roda no PC de casa. Com ele offline, as gravacoes ficam
    // aqui e sao reenviadas quando a maquina volta. So quem pode editar
    // faccoes enfileira; o contador e lido por qualquer usuario ativo
    // para o painel saber, em UMA leitura, se ha algo pendente.
    match /highos/data/fila_bot/{itemId} {
      allow read: if activeUser();
      allow create: if canEdit('faccoes')
                    && request.resource.data.status == 'PENDENTE'
                    && request.resource.data.criadoPor == myEmail();
      allow update: if canEdit('faccoes');
      allow delete: if isAdmin();
    }
    match /highos/fila_bot_status {
      allow read: if activeUser();
      allow write: if canEdit('faccoes');
    }

    // ---------- catalogo de craft e rota ----------
    // As receitas sairam do codigo e passaram a morar aqui, editaveis
    // pela equipe. Um documento so: ler custa 1 leitura.
    match /highos/data/config/catalogo_craft {
      allow read: if activeUser();
      allow write: if canEdit('faccoes');
    }

    // ---------- seasons: QGs e coordenadas vindos da planilha ----------
    // Um documento por season guarda TODOS os QGs. Ler o painel custa
    // 1 leitura, nao uma por QG. Escrever e so do admin, pelo importador.
    match /highos/data/seasons/{seasonId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    match /highos/season_atual {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    // ---------- configuracoes ----------
    match /highos/data/config/segmentos {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    match /highos/data/config/dashboard {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    // V10.6 - o painel deixa configurar o Spotify a quem tem EDIT no modulo,
    // mas a regra exigia ADMIN: o usuario recebia permission-denied em silencio.
    match /highos/data/config/spotify {
      allow read: if activeUser();
      allow write: if canEdit('spotify');
    }
    // V12.7 - documento antigo: continua legivel como copia de seguranca,
    // mas ninguem grava mais nele (as zonas agora ficam em missoes_zonas).
    match /highos/data/config/missoes_planejador {
      allow read: if canView('planejador');
      allow write: if isAdmin();
    }
    // V12.7 - trava da migracao unica para o formato novo
    match /highos/data/config/missoes_migracao {
      allow read: if canView('planejador');
      allow write: if canEdit('planejador');
    }
    // V12.7 - uma zona por documento. "rev" so avanca de 1 em 1: quem esta
    // com versao antiga nao consegue sobrescrever o trabalho de outra pessoa.
    // Exclusao e um marcador (deleted:true); apagar de verdade so ADMIN.
    match /highos/data/missoes_zonas/{zonaId} {
      allow read: if canView('planejador');
      allow create: if canEdit('planejador')
                    && request.resource.data.rev == 1
                    && request.resource.data.updatedBy == myEmail()
                    && request.resource.data.json is string
                    && request.resource.data.json.size() <= 900000;
      allow update: if canEdit('planejador')
                    && request.resource.data.rev == resource.data.rev + 1
                    && request.resource.data.updatedBy == myEmail()
                    && request.resource.data.json is string
                    && request.resource.data.json.size() <= 900000;
      allow delete: if isAdmin();
    }
    match /highos/data/config/{outro} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    // ---------- Ítalo Alves TI (assistência técnica · repo italo-alves-ti) ----------
    // Só o dono acessa. Dados em ti/base/{colecao}/{doc} e ti/base/meta/{config|contadores}.
    function tiDono() {
      return signedIn()
        && myEmail() in ['alvesjardim.italo@gmail.com']
        && request.auth.token.email_verified == true;
    }
    match /ti/{document=**} {
      allow read, write: if tiDono();
    }
    // Site público: qualquer visitante pode CRIAR um pedido ("Fale comigo"),
    // mas não pode ler, alterar nem apagar. Campos e tamanhos travados.
    function tiTexto(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    match /ti/base/leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'whatsapp', 'cidade', 'equipamento', 'problema',
                         'detalhe', 'atendimento', 'servico', 'origem', 'utm', 'indicacao', 'status', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.matches('^[0-9]{10,13}$')
        && tiTexto(request.resource.data, 'cidade', 80)
        && tiTexto(request.resource.data, 'equipamento', 40)
        && tiTexto(request.resource.data, 'problema', 60)
        && tiTexto(request.resource.data, 'detalhe', 1500)
        && tiTexto(request.resource.data, 'atendimento', 40)
        && tiTexto(request.resource.data, 'servico', 40)
        && tiTexto(request.resource.data, 'origem', 120)
        && tiTexto(request.resource.data, 'utm', 120)
        && tiTexto(request.resource.data, 'indicacao', 60)
        && request.resource.data.status == 'Novo'
        && request.resource.data.criadoEm == request.time;
    }
    // "Acompanhar OS": o visitante só LÊ um documento se souber o ID exato
    // (hash do código da OS + telefone). Não dá para listar nem gravar.
    match /ti/base/rastreio/{rastreioId} {
      allow get: if true;
    }

    // ---------- tudo que nao foi previsto fica fechado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
